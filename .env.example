# LLM Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Selection (tiered for cost optimization)
RESEARCH_MODEL=openai/gpt-4o-mini
EXTRACTION_MODEL=anthropic/claude-3-5-haiku-20241022
WRITING_MODEL=anthropic/claude-sonnet-4-20250514
VERIFICATION_MODEL=anthropic/claude-3-5-haiku-20241022

# Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Web Search
TAVILY_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./prolific.db

# ChromaDB
CHROMA_PERSIST_PATH=./chroma_data

# Workflow Limits
MAX_RESEARCH_ITERATIONS=5
MAX_SOURCES_PER_TOPIC=20
MAX_CLAIMS_PER_SOURCE=50
MAX_CONCURRENT_EXTRACTIONS=5
MAX_CONCURRENT_WRITERS=3

# Token Budgets
BOOK_MEMORY_BUDGET=2000
DRAFT_CHUNK_BUDGET=1500
EVIDENCE_BUDGET=4000
